{
  "name": "portfolio2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content:build": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs && vite --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0 && node scripts/check-tsx.mjs",
    "typecheck": "tsc --noEmit",
    "test:content": "node --test tests/content.test.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build-content.mjs && tsc --noEmit && vite build",
    "build:release": "node scripts/build-content.mjs --release && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "lighthouse": "13.4.1",
    "node": "26.8.1",
    "puppeteer-core": "25.3.0",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=26.8.1 <27"
  }
}
